# =====================================================================
# Habibis · Variables de entorno
# Copia este archivo a .env.local (desarrollo) y cárgalas en Vercel
# (Project → Settings → Environment Variables) para producción.
# =====================================================================

# --- Supabase (Project Settings → API) ---------------------------------
# URL del proyecto, p. ej. https://abcdxyz.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública "anon" (o "publishable"). Es segura en el navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave "service_role" (o "secret"). SOLO servidor. Nunca la compartas
# ni la pongas en una variable que empiece por NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- URL pública del sitio (para Open Graph y enlaces) -----------------
# Por ahora la de Vercel, p. ej. https://habibis.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Notificaciones push (Web Push / VAPID) ----------------------------
# Genera el par con:  npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto del responsable (mailto: o https:)
VAPID_SUBJECT=mailto:pagos@habibis.com

# --- WhatsApp del negocio ----------------------------------------------
# Solo dígitos con código de país (Venezuela 58…, Colombia 57…).
# Se usa como respaldo: el número principal se edita en el panel
# (Configuración → Negocio).
NEXT_PUBLIC_WHATSAPP_NUMBER=584120000000

# --- Antispam ------------------------------------------------------------
# Texto aleatorio para anonimizar las IP antes de guardarlas.
IP_HASH_SALT=cambia-esto-por-un-texto-largo-y-aleatorio
